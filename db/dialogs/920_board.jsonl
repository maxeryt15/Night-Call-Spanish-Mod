{"id": "920_board|board-explanation|T224", "type": "NARRATION", "en": "Your goal: to create a backstory for each suspect, to understand who they are and why they kill.", "passage": "board-explanation", "source": "textasset", "es": "", "status": "TODO", "locked": false}
