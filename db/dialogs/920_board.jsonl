{"id": "920_board|board-tutorial|T16", "type": "NARRATION", "en": "You take a second to enjoy the silence of your studio apartment.", "passage": "board-tutorial", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "920_board|board-tutorial|T17", "type": "NARRATION", "en": "Outside, the city is slowly waking up.", "passage": "board-tutorial", "source": "textasset", "es": "", "status": "TODO", "locked": false}
