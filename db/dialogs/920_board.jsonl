{"id": "920_board|board-additionaldocs|T38", "type": "NARRATION", "en": "You take a deep breath and go inside. In the envelope, you find more information, just as Busset promised.", "passage": "board-additionaldocs", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "920_board|board-additionaldocs-end|T71", "type": "NARRATION", "en": "You lay them on the table…", "passage": "board-additionaldocs-end", "source": "textasset", "es": "", "status": "TODO", "locked": false}
