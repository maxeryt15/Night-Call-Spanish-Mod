{"id": "925_phone_suspect|phone-suspect-pickup01|T39", "type": "NARRATION", "en": "You pick up. Busset sounds irritated.", "passage": "phone-suspect-pickup01", "source": "textasset", "es": "", "status": "TODO", "locked": false}
