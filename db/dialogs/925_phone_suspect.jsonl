{"id": "925_phone_suspect|phone-suspect-start|T9", "type": "NARRATION", "en": "The phone rings and you jump. You’re not used to hearing it. No one ever calls you.", "passage": "phone-suspect-start", "source": "textasset", "es": "", "status": "TODO", "locked": false}
