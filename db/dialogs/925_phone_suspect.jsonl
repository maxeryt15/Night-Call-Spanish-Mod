{"id": "925_phone_suspect|phone-suspect-ring03|T25", "type": "NARRATION", "en": "Two more rings. Buzzing in your ears. Your tinnitus is coming on again.", "passage": "phone-suspect-ring03", "source": "textasset", "es": "", "status": "TODO", "locked": false}
