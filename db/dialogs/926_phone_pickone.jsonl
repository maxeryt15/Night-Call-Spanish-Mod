{"id": "926_phone_pickone|phonepick-pickup03|T50", "type": "DIALOGUE", "en": "« Were you on the throne or what? »", "passage": "phonepick-pickup03", "speaker": "BUSSET", "source": "textasset", "es": "", "status": "TODO", "locked": false}
