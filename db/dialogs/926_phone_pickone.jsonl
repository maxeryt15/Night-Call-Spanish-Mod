{"id": "926_phone_pickone|phonepick-start|T7", "type": "NARRATION", "en": "The phone rings. You impulsively take a step back.", "passage": "phonepick-start", "source": "textasset", "es": "El teléfono suena. Das un paso atrás por impulso.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-start|T8", "type": "NARRATION", "en": "It’s the moment of truth.", "passage": "phonepick-start", "source": "textasset", "es": "Es el momento de la verdad.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-start|T9", "type": "CHOICE", "en": "(Pick up.)", "passage": "phonepick-start", "link": "phonepick-pickup01", "source": "textasset", "es": "(Atender.)", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-start|T10", "type": "CHOICE", "en": "(Let it ring.)", "passage": "phonepick-start", "link": "phonepick-ring01", "source": "textasset", "es": "(Dejar que suene.)", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-ring01|T14", "type": "NARRATION", "en": "You picture Busset on the other end of the line.", "passage": "phonepick-ring01", "source": "textasset", "es": "Te imaginas a Busset del otro lado de la línea.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-ring01|T15", "type": "NARRATION", "en": "Annoyed… exasperated.", "passage": "phonepick-ring01", "source": "textasset", "es": "Molesta… exasperada.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-ring01|T16", "type": "CHOICE", "en": "(Pick up.)", "passage": "phonepick-ring01", "link": "phonepick-pickup02", "source": "textasset", "es": "(Atender.)", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-ring01|T17", "type": "CHOICE", "en": "(Let it ring.)", "passage": "phonepick-ring01", "link": "phonepick-ring02", "source": "textasset", "es": "(Dejar que suene.)", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-ring02|T21", "type": "NARRATION", "en": "She’s going to chew you out, no doubt about it.", "passage": "phonepick-ring02", "source": "textasset", "es": "Te va a retar, no hay duda.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup01|T28", "type": "NARRATION", "en": "« Hello? »", "passage": "phonepick-pickup01", "source": "textasset", "es": "« ¿Hola? »", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-pickup01|T29", "type": "DIALOGUE", "en": "« Hi… »", "passage": "phonepick-pickup01", "speaker": "BUSSET", "source": "textasset", "es": "« Hola… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup01|T30", "type": "NARRATION", "en": "Ice cold.", "passage": "phonepick-pickup01", "source": "textasset", "es": "Fría como el hielo.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup01|T31", "type": "DIALOGUE", "en": "« So? »", "passage": "phonepick-pickup01", "speaker": "BUSSET", "source": "textasset", "es": "« ¿Y bien? »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup02|T38", "type": "NARRATION", "en": "« Hello? »", "passage": "phonepick-pickup02", "source": "textasset", "es": "« ¿Hola? »", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-pickup02|T39", "type": "DIALOGUE", "en": "« It’s your favorite police lieutenant… »", "passage": "phonepick-pickup02", "speaker": "BUSSET", "source": "textasset", "es": "« Es tu teniente de policía favorita… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup02|T40", "type": "CHOICE", "en": "« Hey… »", "passage": "phonepick-pickup02", "link": "phonepick-time", "source": "textasset", "es": "« Eh… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup02|T41", "type": "CHOICE", "en": "« I don’t have a favorite police lieutenant. »", "passage": "phonepick-pickup02", "emote": ":irony:", "link": "phonepick-pickup-lateno", "source": "textasset", "es": "« No tengo una teniente de policía favorita. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup02|T42", "type": "CHOICE", "en": "(Say nothing.)", "passage": "phonepick-pickup02", "emote": ":silence:", "link": "phonepick-time", "source": "textasset", "es": "(No decir nada.)", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-pickup03|T47", "type": "NARRATION", "en": "You lean over and grab the receiver impulsively, again.", "passage": "phonepick-pickup03", "source": "textasset", "es": "Te inclinas y agarras el auricular por impulso, otra vez.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup03|T49", "type": "NARRATION", "en": "« Hello? »", "passage": "phonepick-pickup03", "source": "textasset", "es": "« ¿Hola? »", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-pickup03|T50", "type": "DIALOGUE", "en": "« Were you on the throne or what? »", "passage": "phonepick-pickup03", "speaker": "BUSSET", "source": "textasset", "es": "« ¿Estabas en el trono o qué? »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup03|T51", "type": "NARRATION", "en": "« No, no, sorry… »", "passage": "phonepick-pickup03", "source": "textasset", "es": "« No, no, perdón… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-late|T57", "type": "DIALOGUE", "en": "« What did I tell you last time? Huh? »", "passage": "phonepick-pickup-late", "speaker": "BUSSET", "source": "textasset", "es": "« ¿Qué te dije la última vez? ¿Eh? »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-late|T58", "type": "NARRATION", "en": "A touch of static on the line.", "passage": "phonepick-pickup-late", "source": "textasset", "es": "Un toque de estática en la línea.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-late|T59", "type": "DIALOGUE", "en": "« I don’t have any time to waste. I have more important shit to do. »", "passage": "phonepick-pickup-late", "speaker": "BUSSET", "source": "textasset", "es": "« No tengo tiempo que perder. Tengo cosas más importantes que hacer. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-lateno|T64", "type": "NARRATION", "en": "Her voice sounds tired. Like she’s at the end of her rope.", "passage": "phonepick-pickup-lateno", "source": "textasset", "es": "Su voz suena cansada. Como si estuviera al límite.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-lateno|T65", "type": "DIALOGUE", "en": "« Whatever… »", "passage": "phonepick-pickup-lateno", "speaker": "BUSSET", "source": "textasset", "es": "« Como sea… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time|T70", "type": "NARRATION", "en": "She heaves a long sigh. There’s no background noise. She must not be at the station.", "passage": "phonepick-time", "source": "textasset", "es": "Suelta un largo suspiro. No hay ruido de fondo. No debe de estar en la comisaría.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time|T71", "type": "CHOICE", "en": "« Where are you? »", "passage": "phonepick-time", "link": "phonepick-time-where", "source": "textasset", "es": "« ¿Dónde estás? »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time|T72", "type": "CHOICE", "en": "« I’ve got a name for you. »", "passage": "phonepick-time", "link": "phonepick-time-name", "source": "textasset", "es": "« Tengo un nombre para ti. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time|T73", "type": "CHOICE", "en": "(Say nothing.)", "passage": "phonepick-time", "emote": ":silence:", "link": "phonepick-time-silence", "source": "textasset", "es": "(No decir nada.)", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-time-where|T77", "type": "DIALOGUE", "en": "« I’m… »", "passage": "phonepick-time-where", "speaker": "BUSSET", "source": "textasset", "es": "« Estoy… »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time-where|T78", "type": "NARRATION", "en": "For a second, you think she’s going to tell you. But then…", "passage": "phonepick-time-where", "source": "textasset", "es": "Por un segundo, crees que te lo va a decir. Pero entonces…", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time-where|T79", "type": "DIALOGUE", "en": "« Somewhere. None of your business. »", "passage": "phonepick-time-where", "speaker": "BUSSET", "source": "textasset", "es": "« En algún lado. No es asunto tuyo. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time-where|T80", "type": "NARRATION", "en": "A light clinking noise… the sound of a teacup on a coaster maybe?", "passage": "phonepick-time-where", "source": "textasset", "es": "Un leve tintineo… ¿el sonido de una taza de té sobre un platito, tal vez?", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time-name|T85", "type": "DIALOGUE", "en": "« Perfect. I’m listening. »", "passage": "phonepick-time-name", "speaker": "BUSSET", "source": "textasset", "es": "« Perfecto. Te escucho. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-time-silence|T90", "type": "DIALOGUE", "en": "« Good… »", "passage": "phonepick-time-silence", "speaker": "BUSSET", "source": "textasset", "es": "« Bien… »", "status": "TRANSLATED", "locked": false, "origin": "tm"}
{"id": "926_phone_pickone|phonepick-name-intro|T95", "type": "DIALOGUE", "en": "« I’m listening. What have you got for me? »", "passage": "phonepick-name-intro", "speaker": "BUSSET", "source": "textasset", "es": "« Te escucho. ¿Qué tienes para mí? »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name-intro|T96", "type": "NARRATION", "en": "She clears her throat. Her voice sounds… louder… more confident.", "passage": "phonepick-name-intro", "source": "textasset", "es": "Se aclara la garganta. Su voz suena… más fuerte… más segura.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T101", "type": "NARRATION", "en": "You glance at the wall. The suspects are all lined up. All the evidence. A whole mess of your ideas. Your stomach is in a knot.", "passage": "phonepick-name", "source": "textasset", "es": "Le echas un vistazo a la pared. Los sospechosos están todos alineados. Todas las pruebas. Todo un revoltijo de tus ideas. Tienes el estómago hecho un nudo.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T103", "type": "DIALOGUE", "en": "« I don’t have to remind you, you cannot get this wrong. I have a meeting in two hours with the District Attorney. And the Chief of Police. »", "passage": "phonepick-name", "speaker": "BUSSET", "source": "textasset", "es": "« No hace falta que te lo recuerde, no te puedes equivocar. Tengo una reunión en dos horas con el fiscal. Y con el jefe de policía. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T104", "type": "DIALOGUE", "en": "« Even the Minister of the Interior will be in a corner of the room somewhere. »", "passage": "phonepick-name", "speaker": "BUSSET", "source": "textasset", "es": "« Hasta el ministro del Interior va a estar en algún rincón de la sala. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T106", "type": "DIALOGUE", "en": "« Obviously, I’m thrilled. Oh, oh, but, I certainly don’t want to put too much pressure on you. »", "passage": "phonepick-name", "speaker": "BUSSET", "source": "textasset", "es": "« Obviamente, estoy encantada. Ah, ah, pero no quiero presionarte demasiado, claro. »", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T108", "type": "NARRATION", "en": "You can almost hear the smirk she must be wearing.", "passage": "phonepick-name", "source": "textasset", "es": "Casi puedes oír la sonrisita burlona que debe de tener.", "status": "TRANSLATED", "locked": false}
{"id": "926_phone_pickone|phonepick-name|T109", "type": "NARRATION", "en": "You lay the receiver down on the table. Now, you have to decide.", "passage": "phonepick-name", "source": "textasset", "es": "Dejas el auricular sobre la mesa. Ahora, tienes que decidir.", "status": "TRANSLATED", "locked": false}
