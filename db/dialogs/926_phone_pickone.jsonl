{"id": "926_phone_pickone|phonepick-pickup02|T40", "type": "CHOICE", "en": "« Hey… »", "passage": "phonepick-pickup02", "link": "phonepick-time", "source": "textasset", "es": "", "status": "TODO", "locked": false}
