{"id": "926_phone_pickone|phonepick-time|T70", "type": "NARRATION", "en": "She heaves a long sigh. There’s no background noise. She must not be at the station.", "passage": "phonepick-time", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "926_phone_pickone|phonepick-time|T71", "type": "CHOICE", "en": "« Where are you? »", "passage": "phonepick-time", "link": "phonepick-time-where", "source": "textasset", "es": "", "status": "TODO", "locked": false}
