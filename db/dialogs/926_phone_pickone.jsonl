{"id": "926_phone_pickone|phonepick-pickup-late|T58", "type": "NARRATION", "en": "A touch of static on the line.", "passage": "phonepick-pickup-late", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-late|T59", "type": "DIALOGUE", "en": "« I don’t have any time to waste. I have more important shit to do. »", "passage": "phonepick-pickup-late", "speaker": "BUSSET", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "926_phone_pickone|phonepick-pickup-lateno|T64", "type": "NARRATION", "en": "Her voice sounds tired. Like she’s at the end of her rope.", "passage": "phonepick-pickup-lateno", "source": "textasset", "es": "", "status": "TODO", "locked": false}
