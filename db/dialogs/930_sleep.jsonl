{"id": "930_sleep|sleep-client-012christophe|T280", "type": "NARRATION", "en": "Life…", "passage": "sleep-client-012christophe", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "930_sleep|sleep-client-016gerard|T287", "type": "NARRATION", "en": "You think about that guy who just got out of prison.", "passage": "sleep-client-016gerard", "source": "textasset", "es": "", "status": "TODO", "locked": false}
{"id": "930_sleep|sleep-client-016gerard|T288", "type": "NARRATION", "en": "He must be… far from Paris by now… looking at some timeless landscape… like the bell tower of a church in the countryside.", "passage": "sleep-client-016gerard", "source": "textasset", "es": "", "status": "TODO", "locked": false}
